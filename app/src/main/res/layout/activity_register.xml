<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#FFFFFF">

    <!-- 左半：脑图 -->
    <ImageView
        android:id="@+id/ivBrain"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:src="@drawable/bg_brain"
        android:scaleType="centerCrop"
        android:contentDescription="脑图" />

    <!-- 右半：表单区 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingLeft="64dp"
        android:paddingRight="64dp"
        android:background="#FAFCFC">

        <!-- Logo -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="260dp"
            android:layout_height="80dp"
            android:src="@drawable/logo_neurox"
            android:scaleType="fitCenter"
            android:contentDescription="NeuroX Logo" />

        <!-- 中文副标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="多源异构数据采集与管理平台"
            android:textSize="16sp"
            android:textColor="#333333" />

        <!-- 英文副标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Multi-source Heterogeneous Data Platform"
            android:textSize="12sp"
            android:textColor="#888888" />

        <!-- 邮箱/手机号 -->
        <EditText
            android:id="@+id/etAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:hint="请输入邮箱或手机号"
            android:inputType="text"
            android:textSize="15sp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:background="@drawable/bg_input_rounded"
            android:drawableStart="@android:drawable/ic_menu_myplaces"
            android:drawablePadding="12dp" />

        <!-- 设置密码 -->
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="设置密码"
            android:inputType="textPassword"
            android:textSize="15sp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:background="@drawable/bg_input_rounded"
            android:drawableStart="@android:drawable/ic_lock_lock"
            android:drawablePadding="12dp" />

        <!-- 确认密码 -->
        <EditText
            android:id="@+id/etConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="确认密码"
            android:inputType="textPassword"
            android:textSize="15sp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:background="@drawable/bg_input_rounded"
            android:drawableStart="@android:drawable/ic_lock_lock"
            android:drawablePadding="12dp" />

        <!-- 同意条款 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_gravity="start"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cbAgree"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#1BB8B0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="同意条款"
                android:textSize="13sp"
                android:textColor="#666666" />

        </LinearLayout>

        <!-- 注册按钮 -->
        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:text="立即注册"
            android:textSize="17sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1BB8B0" />

        <!-- 返回 -->
        <TextView
            android:id="@+id/tvBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="返回"
            android:textSize="13sp"
            android:textColor="#1BB8B0" />

    </LinearLayout>

</LinearLayout>