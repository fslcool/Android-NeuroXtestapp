<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/bg_main">

    <!-- ============ 左侧导航 ============ -->
    <LinearLayout
        android:layout_width="220dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_left_nav"
        android:padding="24dp">

        <!-- 返回圆按钮 -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="@drawable/bg_input_rounded"
            android:backgroundTint="#4DB6AC"
            android:contentDescription="返回" />

        <!-- Logo -->
        <ImageView
            android:layout_width="120dp"
            android:layout_height="44dp"
            android:layout_marginTop="25dp"
            android:src="@drawable/logo_neurox"
            android:scaleType="fitStart"
            android:translationX="-8dp"
            android:contentDescription="NeuroX Logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Start Experiment"
            android:textSize="14sp"
            android:textColor="#888888"
            android:translationX="1dp"
            android:translationY="-8dp"/>

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#D0E5E5" />

        <!-- ===== 导航项：设置 ===== -->
        <LinearLayout
            android:id="@+id/navSetup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 圆点 -->
            <View
                android:id="@+id/dotSetup"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/bg_dot_selected" />

            <TextView
                android:id="@+id/tvNavSetup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:text="设置 Setup"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1BA39A" />

        </LinearLayout>

        <!-- 竖线 -->
        <View
            android:layout_width="2dp"
            android:layout_height="32dp"
            android:layout_marginLeft="9dp"
            android:background="#D0E5E5" />

        <!-- ===== 导航项：检测 ===== -->
        <LinearLayout
            android:id="@+id/navInspection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/dotInspection"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/bg_dot_normal" />

            <TextView
                android:id="@+id/tvNavInspection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:text="检测 Inspection"
                android:textSize="15sp"
                android:textColor="#999999" />

        </LinearLayout>

        <!-- 竖线 -->
        <View
            android:layout_width="2dp"
            android:layout_height="32dp"
            android:layout_marginLeft="9dp"
            android:background="#D0E5E5" />

        <!-- ===== 导航项：监控 ===== -->
        <LinearLayout
            android:id="@+id/navMonitor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/dotMonitor"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/bg_dot_normal" />

            <TextView
                android:id="@+id/tvNavMonitor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:text="监控 Monitor"
                android:textSize="15sp"
                android:textColor="#999999" />

        </LinearLayout>

        <!-- 撑开空间，把状态栏推到底部 -->
        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 连接状态 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="连接服务器地址："
            android:textSize="12sp"
            android:textColor="#888888" />

        <TextView
            android:id="@+id/tvServerAddr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="---"
            android:textSize="13sp"
            android:textColor="#333333" />

        <TextView
            android:id="@+id/tvConnStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="连接中..."
            android:textSize="13sp"
            android:textColor="#666666" />

    </LinearLayout>

    <!-- ============ 中间：被试信息卡 ============ -->
    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/bg_info_card"
            android:padding="24dp"
            android:elevation="4dp">

            <!-- 标题 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="被试信息"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#222222" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:text="Subject Info"
                    android:textSize="12sp"
                    android:textColor="#999999" />

            </LinearLayout>

            <!-- 姓名 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="姓名 Name"
                android:textSize="13sp"
                android:textColor="#333333" />

            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:hint="Please enter name"
                android:textSize="12sp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:background="@drawable/bg_input_rounded" />

            <!-- 学号 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="学号 ID"
                android:textSize="13sp"
                android:textColor="#333333" />

            <EditText
                android:id="@+id/etId"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:hint="Please enter ID"
                android:textSize="12sp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:background="@drawable/bg_input_rounded" />

            <!-- 年龄 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="年龄 Age"
                android:textSize="13sp"
                android:textColor="#333333" />

            <EditText
                android:id="@+id/etAge"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:hint="Please enter Age"
                android:textSize="12sp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:inputType="number"
                android:background="@drawable/bg_input_rounded" />

            <!-- 性别 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="性别 Gender"
                android:textSize="13sp"
                android:textColor="#333333" />

            <RadioGroup
                android:id="@+id/rgGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbMale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="#1BA39A"
                    android:text="男 Man"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbFemale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:buttonTint="#1BA39A"
                    android:text="女 Female"
                    android:textSize="13sp" />

            </RadioGroup>

            <!-- 被试编号 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="被试编号"
                android:textSize="13sp"
                android:textColor="#333333" />

            <!-- 被试编号输入框 + 扫码按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etSubjectId"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:hint="尚未扫码 / 可手动输入"
                    android:textSize="13sp"
                    android:textColor="#222222"
                    android:textColorHint="#999999"
                    android:inputType="text"
                    android:singleLine="true"
                    android:background="@drawable/bg_input_rounded" />

                <TextView
                    android:id="@+id/btnScan"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginLeft="8dp"
                    android:gravity="center"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:text="扫码"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_btn_next"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- 撑开，把按钮顶到底部 -->
            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- 底部两个按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnEdit"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="修改"
                    android:textSize="14sp"
                    android:textColor="#1BA39A"
                    android:background="@drawable/bg_btn_outline"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnConfirm"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginLeft="12dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="确认"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_btn_filled"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- ============ 右侧：范式选择 ============ -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/bg_info_card"
            android:padding="20dp"
            android:elevation="4dp">

            <!-- ===== 顶部标签栏 ===== -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="end">

                <TextView
                    android:id="@+id/tagAll"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:gravity="center"
                    android:text="全部 All"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:background="@drawable/bg_tag_normal" />

                <TextView
                    android:id="@+id/tagResting"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginLeft="10dp"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:gravity="center"
                    android:text="静息态 Resting"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:background="@drawable/bg_tag_normal" />

                <TextView
                    android:id="@+id/tagEmotion"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginLeft="10dp"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:gravity="center"
                    android:text="情绪 Emotion"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_tag_selected" />

                <TextView
                    android:id="@+id/tagCognition"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginLeft="10dp"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:gravity="center"
                    android:text="认知 Cognition"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:background="@drawable/bg_tag_normal" />

            </LinearLayout>

            <!-- ===== 九宫格卡片区 ===== -->
            <!-- 范式选择区（可滑动） -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPagerParadigm"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="20dp" />

            <!-- "暂无"提示（默认隐藏） -->
            <TextView
                android:id="@+id/tvEmptyHint"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="暂无"
                android:textSize="16sp"
                android:textColor="#999999"
                android:visibility="gone" />

            <!-- ===== 底部：翻页 + 下一步 ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- 翻页圆点 -->
                <LinearLayout
                    android:id="@+id/llDots"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <View
                        android:id="@+id/dotPage1"
                        android:layout_width="20dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_dot_selected" />

                    <View
                        android:id="@+id/dotPage2"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginLeft="6dp"
                        android:background="@drawable/bg_dot_normal" />

                </LinearLayout>

                <!-- 下一步按钮 -->
                <TextView
                    android:id="@+id/btnNext"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:paddingLeft="32dp"
                    android:paddingRight="32dp"
                    android:text="下一步 →"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_btn_next"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>