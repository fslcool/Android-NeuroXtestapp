<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/bg_main">

    <!-- ============ 左侧导航（和实验页一致） ============ -->
    <LinearLayout
        android:layout_width="220dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_left_nav"
        android:padding="24dp">

        <!-- 返回圆按钮 -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="@drawable/bg_input_rounded"
            android:backgroundTint="#4DB6AC"
            android:contentDescription="返回" />

        <!-- Logo -->
        <ImageView
            android:layout_width="120dp"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/logo_neurox"
            android:scaleType="fitStart"
            android:contentDescription="NeuroX Logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Start Experiment"
            android:textSize="12sp"
            android:textColor="#888888" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#D0E5E5" />

        <!-- ===== 导航项：设置 ===== -->
        <LinearLayout
            android:id="@+id/navSetup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/dotSetup"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/bg_dot_normal" />

            <TextView
                android:id="@+id/tvNavSetup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:text="设置 Setup"
                android:textSize="15sp"
                android:textColor="#999999" />

        </LinearLayout>

        <View
            android:layout_width="2dp"
            android:layout_height="32dp"
            android:layout_marginLeft="9dp"
            android:background="#D0E5E5" />

        <!-- ===== 导航项：检测（高亮） ===== -->
        <LinearLayout
            android:id="@+id/navInspection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/dotInspection"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/bg_dot_selected" />

            <TextView
                android:id="@+id/tvNavInspection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:text="检测 Inspection"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1BA39A" />

        </LinearLayout>

        <View
            android:layout_width="2dp"
            android:layout_height="32dp"
            android:layout_marginLeft="9dp"
            android:background="#D0E5E5" />

        <!-- ===== 导航项：监控 ===== -->
        <LinearLayout
            android:id="@+id/navMonitor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/dotMonitor"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/bg_dot_normal" />

            <TextView
                android:id="@+id/tvNavMonitor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:text="监控 Monitor"
                android:textSize="15sp"
                android:textColor="#999999" />

        </LinearLayout>

        <!-- 撑开空间，把状态栏推到底部 -->
        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 连接状态 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="连接服务器地址："
            android:textSize="12sp"
            android:textColor="#888888" />

        <TextView
            android:id="@+id/tvServerAddr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="---"
            android:textSize="13sp"
            android:textColor="#333333" />

        <TextView
            android:id="@+id/tvConnStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="连接中..."
            android:textSize="13sp"
            android:textColor="#666666" />

    </LinearLayout>

    <!-- ============ 中间：电极图 ============ -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- 背景：脑电帽轮廓图 -->
            <ImageView
                android:id="@+id/ivMachine"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/eeg_cap_outline"
                android:scaleType="fitCenter"
                android:contentDescription="电极分布图" />

            <!-- 前景：8 个动态通道点 -->
            <com.fsl.neuroxapptest.EegCapView
                android:id="@+id/eegCapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </FrameLayout>

        <!-- 底部按钮 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnPrev"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center"
                android:paddingLeft="32dp"
                android:paddingRight="32dp"
                android:text="← 上一步"
                android:textSize="14sp"
                android:textColor="#1BA39A"
                android:background="@drawable/bg_btn_outline"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnNext"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginLeft="16dp"
                android:gravity="center"
                android:paddingLeft="32dp"
                android:paddingRight="32dp"
                android:text="下一步 →"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_filled"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

    <!-- ============ 右侧：实时阻抗表 ============ -->
    <LinearLayout
        android:layout_width="380dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/bg_info_card"
            android:padding="24dp"
            android:elevation="4dp">

            <!-- 标题 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="实时阻抗"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#222222" />

            <!-- 表头 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Channel"
                    android:textSize="12sp"
                    android:textColor="#999999" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Status"
                    android:textSize="12sp"
                    android:textColor="#999999" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Impedance"
                    android:textSize="12sp"
                    android:textColor="#999999" />

            </LinearLayout>

            <!-- 分隔线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:background="#EEEEEE" />

            <!-- 滚动表格 -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="4dp">

                <LinearLayout
                    android:id="@+id/llChannelList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </ScrollView>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>